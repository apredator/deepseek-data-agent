# ===========================================================================
# DeepSeek (primary LLM backend, supports native function calling)
# ===========================================================================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# deepseek-chat works with or without the /v1 suffix
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ===========================================================================
# LLM provider selection
#   deepseek | hf | mock
# ===========================================================================
LLM_PROVIDER=deepseek

# Hugging Face Inference Providers - optional secondary/fallback backend
# (uses the ReAct fallback because HF models rarely expose native tool calling)
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_API_BASE=https://router.huggingface.co/v1
ENABLE_HF_FALLBACK=False

# ===========================================================================
# Paths (relative paths are resolved against the repository root)
# ===========================================================================
DATA_DIR=data
OUTPUT_DIR=outputs
LOG_DIR=logs

# ===========================================================================
# Logging
# ===========================================================================
LOG_LEVEL=INFO
DEBUG=False

# ===========================================================================
# Agent loop / guardrails
# ===========================================================================
MAX_TOOL_ITERATIONS=5          # hard cap on the tool-calling loop
ALLOW_REACT_FALLBACK=True      # text-based ReAct when function calling is unavailable
AGENT_READ_ONLY=True           # refuse any mutating tool
ENABLE_SEMANTIC_TOOLS=False    # add find_similar_employee_names (needs optional deps)
REQUEST_TIMEOUT_SECONDS=60

# ===========================================================================
# Anomaly thresholds
# ===========================================================================
SALARY_JUMP_THRESHOLD_PCT=40

# ===========================================================================
# Synthetic dataset generator (all data produced is fictional)
# ===========================================================================
SYNTHETIC_NUM_EMPLOYEES=600
SYNTHETIC_NUM_PERIODS=12
SYNTHETIC_CLOSED_PERIODS=9     # periods 1..N are "already closed" for corrections
SYNTHETIC_SEED=42
SYNTHETIC_INJECTION_PROBE=True # plant a prompt-injection payload in one name field

# ===========================================================================
# Hugging Face Datasets Hub (optional mirror of the synthetic dataset)
# ===========================================================================
HF_DATASET_REPO=
